## ORIGINAL Digilent ZYBO JA/XADC pins.
## No digital IOSTANDARD is forced: these ports are used as XADC analog inputs.
set_property PACKAGE_PIN K14 [get_ports vauxp6]
set_property PACKAGE_PIN J14 [get_ports vauxn6]
set_property PACKAGE_PIN L14 [get_ports vauxp7]
set_property PACKAGE_PIN L15 [get_ports vauxn7]
set_property PACKAGE_PIN N15 [get_ports vauxp14]
set_property PACKAGE_PIN N16 [get_ports vauxn14]
set_property PACKAGE_PIN K16 [get_ports vauxp15]
set_property PACKAGE_PIN J16 [get_ports vauxn15]
